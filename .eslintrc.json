{
  "root": true,
  "env": {
    "browser": true,
    "es2022": true
  },
  "extends": ["eslint:recommended"],
  "globals": {
    "Chart": "readonly",
    "CONFIG": "readonly",
    "supabase": "readonly",
    "authHelpers": "readonly",
    "sharedUtils": "readonly",
    "logout": "readonly",
    "DashboardAi": "readonly",
    "DashboardApi": "readonly",
    "DashboardApp": "readonly",
    "DashboardEvents": "readonly",
    "DashboardExport": "readonly",
    "DashboardLoader": "readonly",
    "DashboardRender": "readonly",
    "DashboardState": "readonly",
    "PlanDashboardApi": "readonly",
    "PlanDashboardEvents": "readonly",
    "PlanDashboardPage": "readonly",
    "PlanDashboardReferenceData": "readonly",
    "PlanDashboardRender": "readonly",
    "PlanDashboardRenderReferences": "readonly",
    "PlanDashboardRenderRhythm": "readonly",
    "PlanDashboardRenderShared": "readonly",
    "PlanDashboardRenderTable": "readonly",
    "PlanDashboardState": "readonly",
    "PlanDashboardUtils": "readonly"
  },
  "rules": {
    "curly": ["error", "multi-line"],
    "eqeqeq": ["error", "always", { "null": "ignore" }],
    "no-inner-declarations": "off",
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }],
    "no-var": "off"
  }
}
