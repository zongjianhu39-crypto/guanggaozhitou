#!/bin/bash
# Pre-commit hook: 在提交前自动运行密钥扫描
# 安装: cp tools/hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit

set -euo pipefail

# 确保 rg 等工具在 PATH 中（Git hook 环境的 PATH 可能不完整）
# 动态加载 nvm，兼容任意用户/Node版本；不用硬编码路径
export NVM_DIR="$HOME/.nvm"
if [ -s "$NVM_DIR/nvm.sh" ]; then
  \. "$NVM_DIR/nvm.sh"
fi
export PATH="$HOME/.local/bin:/usr/local/bin:/opt/homebrew/bin:$PATH"

REPO_ROOT="$(git rev-parse --show-toplevel)"

echo "🔍 Pre-commit: Running secret scan..."

if [ -f "$REPO_ROOT/tools/checks/check-no-keys.sh" ]; then
  bash "$REPO_ROOT/tools/checks/check-no-keys.sh"
  if [ $? -ne 0 ]; then
    echo ""
    echo "❌ 提交被阻止：检测到潜在密钥泄露！"
    echo "   如果是误报，请在 check-no-keys.sh 中添加排除规则。"
    echo "   强制提交（不推荐）: git commit --no-verify"
    exit 1
  fi
else
  echo "❌ check-no-keys.sh not found. Commit blocked because the secret scan cannot run."
  exit 1
fi

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

# 检查是否有大文件意外提交
echo "🔍 Pre-commit: Checking for large files..."
for file in $STAGED_FILES; do
  if [ -f "$file" ]; then
    SIZE=$(wc -c < "$file")
    if [ "$SIZE" -gt 1048576 ]; then
      SIZE_MB=$(( (SIZE + 1048575) / 1048576 ))
      echo "❌ 文件过大: $file (${SIZE_MB}MB)"
      echo "   超过 1MB 限制，请确认是否需要提交。"
      exit 1
    fi
  fi
done

# 对 staged 的前端 JS 文件跑 ESLint（只阻断 error，warning 放行）
STAGED_JS=$(echo "$STAGED_FILES" | grep -E '^(assets/js/[^/]+\.js|[^/]+\.js)$' || true)
if [ -n "$STAGED_JS" ] && [ -x "$REPO_ROOT/node_modules/.bin/eslint" ]; then
  echo "🔍 Pre-commit: Linting staged JS files..."
  # shellcheck disable=SC2086
  "$REPO_ROOT/node_modules/.bin/eslint" --no-error-on-unmatched-pattern $STAGED_JS
  if [ $? -ne 0 ]; then
    echo ""
    echo "❌ 提交被阻止：ESLint 检查未通过！"
    echo "   修复上述错误后重试；或临时绕过: git commit --no-verify"
    exit 1
  fi
elif [ -n "$STAGED_JS" ]; then
  echo "ℹ️  Skip ESLint: node_modules/.bin/eslint 未安装（npm install 后启用）"
fi

echo "✅ Pre-commit checks passed."
